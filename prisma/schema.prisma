// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(uuid())
  username     String       @unique
  repertoires  Repertoire[]
}

model Repertoire {
  id           String                   @id @default(uuid())
  title        String
  color        String                   // "white" or "black"
  userId       String
  user         User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stats        RepertoirePositionStat[]
  nodes        RepertoireNode[]
  moves        RepertoireMove[]
}

// --- THE CACHE LAYER ---

model PositionCache {
  fen            String   @id // Normalized FEN (no clocks)
  eco            String?
  openingName    String?
  wikiText       String?

  explorerMoves  ExplorerMoveCache[]
  engineEvals    EngineEvalCache[]
  repertoireNodes RepertoireNode[]
}

model ExplorerMoveCache {
  id         String   @id @default(uuid())
  positionId String   // FK to PositionCache.fen
  dbType     String   // "masters", "elite", "amateur"
  san        String
  games      Int
  whiteWins  Float
  draws      Float
  blackWins  Float

  position   PositionCache @relation(fields: [positionId], references: [fen], onDelete: Cascade)
  
  @@unique([positionId, dbType, san])
}

model EngineEvalCache {
  id         String   @id @default(uuid())
  positionId String   // FK to PositionCache.fen
  san        String
  cp         Float
  mate       Int?
  rank       Int
  source     String   // "lichess" or "chessdb"

  position   PositionCache @relation(fields: [positionId], references: [fen], onDelete: Cascade)

  @@unique([positionId, san, source])
}


// --- THE ALGORITHM LAYER ---

model RepertoireNode {
  id             String   @id @default(uuid()) // Unique ID for this specific path
  repertoireId   String   
  fen            String   // FK to PositionCache
  pgn            String   // The unique move history
  cumulativeProb Float    @default(0)
  isAmateurTrap  Boolean  @default(false)
  isMasterThreat Boolean  @default(false)

  cache          PositionCache @relation(fields: [fen], references: [fen], onDelete: Cascade)
  repertoire     Repertoire    @relation(fields: [repertoireId], references: [id], onDelete: Cascade)

  incomingMoves  RepertoireMove[] @relation("IncomingMoves")
  outgoingMoves  RepertoireMove[] @relation("OutgoingMoves")
  stats          RepertoirePositionStat[]
  
  @@unique([repertoireId, pgn]) // A specific PGN history is unique per repertoire
}

model RepertoireMove {
  id              String   @id @default(uuid())
  repertoireId    String
  fromNodeId      String
  toNodeId        String
  san             String
  playerTurn      String   // "OPPONENT" or "RESPONSE"
  
  // Opponent specific fields
  prob            Float?
  trueProbability Float?

  // Response specific fields
  weightedCount   Float?
  lichessCp       Float?
  chessdbCp       Float?
  engineSource    String?
  isDeepVerified  Boolean  @default(false)

  fromNode        RepertoireNode @relation("OutgoingMoves", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNode          RepertoireNode @relation("IncomingMoves", fields: [toNodeId], references: [id], onDelete: Cascade)
  repertoire      Repertoire     @relation(fields: [repertoireId], references: [id], onDelete: Cascade)
  stats           RepertoirePositionStat[]

  @@unique([fromNodeId, san])
}

model RepertoirePositionStat {
  id           String     @id @default(uuid())
  repertoireId String
  nodeId       String
  targetMoveId String

  repertoire   Repertoire @relation(fields: [repertoireId], references: [id], onDelete: Cascade)
  node         RepertoireNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  targetMove   RepertoireMove @relation(fields: [targetMoveId], references: [id], onDelete: Cascade)

  // Natural Language Explanation of the plan (e.g. from Gemini)
  explanation  String?
  tags         String?

  // --- EXACT TS-FSRS CARD OBJECT ---
  due            DateTime @default(now()) // Next review date
  stability      Float    @default(0)     // Memory stability
  difficulty     Float    @default(0)     // Memory difficulty
  elapsed_days   Int      @default(0)     // Days since last review
  scheduled_days Int      @default(0)     // The new "Interval"
  reps           Int      @default(0)     // Total times reviewed
  lapses         Int      @default(0)     // Times you pressed "1" (Again)
  state          Int      @default(0)     // 0=New, 1=Learning, 2=Review, 3=Relearning
  last_review    DateTime?                // When you last saw it
  
  createdAt      DateTime @default(now())

  @@unique([repertoireId, nodeId]) // Ensure a user has only one set of stats per node per repertoire
}
