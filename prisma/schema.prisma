// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          String       @id @default(uuid())
  username    String       @unique
  repertoires Repertoire[]
}

model Repertoire {
  id                  String                   @id @default(uuid())
  title               String
  color               String // "white" or "black"
  userId              String
  user                User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  generationStatus    String                   @default("IDLE")
  completedConfigHash String?
  stats               RepertoirePositionStat[]
  nodes               RepertoireNode[]
  moves               RepertoireMove[]
  humanSnapshots      HumanDataSnapshot[]
}

// --- PERMANENT CHESS IDENTITY ---

model Position {
  positionKey       String               @id
  nodes             RepertoireNode[]
  humanFetches      HumanExplorerFetch[]
  ExplorerMoveCache ExplorerMoveCache[]
}

// --- TEMPORARY SNAPSHOTS ---

model HumanDataSnapshot {
  id                     String   @id @default(uuid())
  repertoireId           String
  startedAt              DateTime @default(now())
  explorerRequestProfile String

  repertoire        Repertoire           @relation(fields: [repertoireId], references: [id], onDelete: Cascade)
  fetches           HumanExplorerFetch[]
  ExplorerMoveCache ExplorerMoveCache[]
  nodes             RepertoireNode[]
  moves             RepertoireMove[]
}

model HumanExplorerFetch {
  id           String @id @default(uuid())
  snapshotId   String
  positionKey  String
  databaseType String // "MASTERS" | "ELITE" | "AMATEUR"

  snapshot HumanDataSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  position Position          @relation(fields: [positionKey], references: [positionKey], onDelete: Restrict)

  @@unique([snapshotId, positionKey, databaseType])
}

// --- THE CACHE LAYER ---

model PositionCache {
  fen String @id // Legacy position-level cache identity only
}

model ExplorerMoveCache {
  id           String @id @default(uuid())
  snapshotId   String
  positionKey  String
  databaseType String // "MASTERS" | "ELITE" | "AMATEUR"
  uci          String
  san          String
  games        Int
  whiteWins    Float
  draws        Float
  blackWins    Float

  snapshot HumanDataSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  position Position          @relation(fields: [positionKey], references: [positionKey], onDelete: Restrict)

  @@unique([snapshotId, positionKey, databaseType, uci])
  @@index([snapshotId, positionKey, databaseType])
}

model RemoteEngineFetch {
  id                String                  @id @default(uuid())
  fullFen           String
  source            String // "LICHESS" or "CHESSDB"
  evaluationProfile String
  fetchedAt         DateTime                @default(now())
  evaluations       RemoteEngineEvalCache[]

  @@unique([fullFen, source, evaluationProfile])
}

model RemoteEngineEvalCache {
  id      String  @id @default(uuid())
  fetchId String
  uci     String
  san     String?
  cp      Float?
  mate    Int?

  fetch RemoteEngineFetch @relation(fields: [fetchId], references: [id], onDelete: Cascade)

  @@unique([fetchId, uci])
}

model LocalEngineBaseline {
  id                String   @id @default(uuid())
  fullFen           String
  evaluationProfile String
  bestUci           String
  san               String?
  cp                Float?
  mate              Int?
  analysedAt        DateTime @default(now())

  @@unique([fullFen, evaluationProfile])
}

model LocalEngineCandidate {
  id                String   @id @default(uuid())
  fullFen           String
  candidateUci      String
  evaluationProfile String
  san               String?
  cp                Float?
  mate              Int?
  analysedAt        DateTime @default(now())

  @@unique([fullFen, candidateUci, evaluationProfile])
}

// --- THE ALGORITHM LAYER ---

model RepertoireNode {
  id                    String  @id @default(uuid()) // Unique ID for this specific path
  repertoireId          String
  fullFen               String // Canonical exact state
  positionKey           String // FK to permanent Position
  history               String  @default("") // Canonical UCI/LAN move sequence
  displayPgn            String  @default("") // Derived SAN display history
  pgn                   String  @default("") // Legacy SAN display alias during migration
  eco                   String?
  openingName           String?
  openingMetadataStatus String? // "PRESENT" or "VALID_ABSENCE"
  openingMetadataSource String? // "LICHESS_MASTERS"
  cumulativeProb        Float   @default(0)
  isTransposition       Boolean @default(false)
  humanDataSnapshotId   String?
  wikibooksChecked      Boolean @default(false)
  wikiText              String?

  position          Position           @relation(fields: [positionKey], references: [positionKey], onDelete: Restrict)
  repertoire        Repertoire         @relation(fields: [repertoireId], references: [id], onDelete: Cascade)
  humanDataSnapshot HumanDataSnapshot? @relation(fields: [humanDataSnapshotId], references: [id], onDelete: Restrict)

  incomingMoves RepertoireMove[]         @relation("IncomingMoves")
  outgoingMoves RepertoireMove[]         @relation("OutgoingMoves")
  stats         RepertoirePositionStat[]

  @@index([repertoireId, history])
  @@index([repertoireId, positionKey])
}

model RepertoireMove {
  id           String  @id @default(uuid())
  repertoireId String
  fromNodeId   String
  toNodeId     String?
  san          String
  uci          String?
  playerTurn   String // "OPPONENT" or "RESPONSE"

  // Opponent specific fields
  prob                Float?
  routeProbability    Float?
  trueProbability     Float? // Legacy alias; new writes use routeProbability
  routeHistory        String?
  stopReason          String?
  humanDataSnapshotId String?

  // Response specific fields
  weightedCount          Float?
  mastersGames           Int?
  eliteGames             Int?
  totalRelevantGames     Int?
  moveShare              Float?
  engineRank             Int?
  cp                     Float?
  mate                   Int?
  source                 String?
  selectionMethod        String?
  moveOrigin             String?
  deepVerified           Boolean @default(false)
  localEvaluationProfile String?

  fromNode          RepertoireNode           @relation("OutgoingMoves", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNode            RepertoireNode?          @relation("IncomingMoves", fields: [toNodeId], references: [id], onDelete: Cascade)
  repertoire        Repertoire               @relation(fields: [repertoireId], references: [id], onDelete: Cascade)
  humanDataSnapshot HumanDataSnapshot?       @relation(fields: [humanDataSnapshotId], references: [id], onDelete: Restrict)
  stats             RepertoirePositionStat[]

  @@unique([fromNodeId, uci])
}

model RepertoirePositionStat {
  id           String  @id @default(uuid())
  repertoireId String
  positionKey  String?
  targetUci    String?
  nodeId       String?
  targetMoveId String?

  repertoire Repertoire      @relation(fields: [repertoireId], references: [id], onDelete: Cascade)
  node       RepertoireNode? @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  targetMove RepertoireMove? @relation(fields: [targetMoveId], references: [id], onDelete: SetNull)

  // Natural Language Explanation of the plan (e.g. from Gemini)
  explanation String?
  tags        String?

  // --- EXACT TS-FSRS CARD OBJECT ---
  due            DateTime  @default(now()) // Next review date
  stability      Float     @default(0) // Memory stability
  difficulty     Float     @default(0) // Memory difficulty
  elapsed_days   Int       @default(0) // Days since last review
  scheduled_days Int       @default(0) // The new "Interval"
  reps           Int       @default(0) // Total times reviewed
  lapses         Int       @default(0) // Times you pressed "1" (Again)
  state          Int       @default(0) // 0=New, 1=Learning, 2=Review, 3=Relearning
  last_review    DateTime? // When you last saw it

  createdAt DateTime @default(now())

  @@unique([repertoireId, positionKey, targetUci])
  @@unique([repertoireId, nodeId])
}
