// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          String       @id @default(uuid())
  username    String       @unique
  repertoires Repertoire[]
}

model Repertoire {
  id                   String                        @id @default(uuid())
  title                String
  color                String // "white" or "black"
  userId               String
  user                 User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  generationStatus     String                        @default("IDLE")
  completedConfigHash  String?
  stats                RepertoirePositionStat[]
  nodes                RepertoireNode[]
  moves                RepertoireMove[]
  positions            Position[]
  wikibooksCache       WikibooksHistoryCache[]
  openingMetadataCache OpeningMetadataHistoryCache[]
}

// --- THE CACHES (DB.30: they survive the wipe) ---

// DB.31, EX.01: Explorer data, one row per position per cache profile.
// Only the Amateur dataset is fetched. No move rows means the position was
// fetched and has no games (State B).
model PositionCache {
  id                 String   @id @default(uuid())
  positionKey        String
  cacheProfile       String
  positionTotalGames Int
  eco                String?
  openingName        String?
  fetchedAt          DateTime @default(now())

  moves PositionCacheMove[]

  @@unique([positionKey, cacheProfile])
}

model PositionCacheMove {
  id        String @id @default(uuid())
  cacheId   String
  uci       String
  san       String
  games     Int
  whiteWins Int
  draws     Int
  blackWins Int

  cache PositionCache @relation(fields: [cacheId], references: [id], onDelete: Cascade)

  @@unique([cacheId, uci])
}

// DB.32: engine evaluations, against the exact fullFen and the local Stockfish
// profile, which includes the Stockfish version. Only local Stockfish writes them.
model EngineCache {
  id            String   @id @default(uuid())
  fullFen       String
  engineProfile String
  engine        String // "LOCAL"
  fetchedAt     DateTime @default(now())

  evaluations EngineCacheEvaluation[]

  @@unique([fullFen, engine, engineProfile])
}

model EngineCacheEvaluation {
  id      String  @id @default(uuid())
  cacheId String
  uci     String
  san     String?
  cp      Float?
  mate    Int?
  rank    Int? // 1 for Stockfish's best move, otherwise null

  cache EngineCache @relation(fields: [cacheId], references: [id], onDelete: Cascade)

  @@unique([cacheId, uci])
}

// DB.34 #deferred
model WikibooksHistoryCache {
  id           String   @id @default(uuid())
  repertoireId String
  history      String
  wikiText     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  repertoire Repertoire @relation(fields: [repertoireId], references: [id], onDelete: Cascade)

  @@unique([repertoireId, history])
}

// DB.33: the result of DB.06, per route.
model OpeningMetadataHistoryCache {
  id           String   @id @default(uuid())
  repertoireId String
  history      String
  status       String // "PRESENT" or "VALID_ABSENCE"
  eco          String?
  openingName  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  repertoire Repertoire @relation(fields: [repertoireId], references: [id], onDelete: Cascade)

  @@unique([repertoireId, history])
}

// --- THE TREE (DB.02: wiped and rebuilt on every run) ---

// DB.36: not a cache. positionKey --> the node that owns that position.
model Position {
  repertoireId String
  positionKey  String
  nodeId       String @unique

  repertoire Repertoire     @relation(fields: [repertoireId], references: [id], onDelete: Cascade)
  node       RepertoireNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@id([repertoireId, positionKey])
}

model RepertoireNode {
  id           String @id @default(uuid())
  repertoireId String

  // DB.03 identity
  positionKey String
  fullFen     String
  history     String @default("") // UCI
  displayPgn  String @default("") // SAN

  // DB.04 probability
  routeProb          Float
  cumProb            Float
  rareDropped        Float @default(0)
  unaccountedDropped Float @default(0)

  // DB.05 transposition marker: set on a pointer, null on an owner
  transposesTo String?

  // DB.06 opening metadata
  eco                   String?
  openingName           String?
  openingMetadataStatus String? // "PRESENT" or "VALID_ABSENCE"

  // DB.07 #deferred
  wikibooksChecked Boolean @default(false)
  wikiText         String?

  // DB.16 ordering
  siblingIndex Int?

  repertoire Repertoire       @relation(fields: [repertoireId], references: [id], onDelete: Cascade)
  owner      RepertoireNode?  @relation("Transposition", fields: [transposesTo], references: [id], onDelete: SetNull)
  pointers   RepertoireNode[] @relation("Transposition")
  ownedPosition Position?

  incomingMoves RepertoireMove[]         @relation("IncomingMoves")
  outgoingMoves RepertoireMove[]         @relation("OutgoingMoves")
  stats         RepertoirePositionStat[]

  @@index([repertoireId, history])
  @@index([repertoireId, positionKey])
}

model RepertoireMove {
  id           String  @id @default(uuid())
  repertoireId String
  fromNodeId   String
  toNodeId     String?
  san          String
  uci          String?
  playerTurn   String // DB.08: "OPPONENT" (White) or "RESPONSE" (Black)

  // DB.10 White move fields
  moveProb Float?

  // DB.20
  stopReason String?

  // DB.14 Black move fields: the engine evidence
  cp              Float?
  mate            Int?
  source          String?
  selectionMethod String?
  moveOrigin      String?
  engineRank      Int?

  fromNode   RepertoireNode           @relation("OutgoingMoves", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNode     RepertoireNode?          @relation("IncomingMoves", fields: [toNodeId], references: [id], onDelete: Cascade)
  repertoire Repertoire               @relation(fields: [repertoireId], references: [id], onDelete: Cascade)
  stats      RepertoirePositionStat[]

  @@unique([fromNodeId, uci])
}

model RepertoirePositionStat {
  id           String  @id @default(uuid())
  repertoireId String
  positionKey  String?
  targetUci    String?
  nodeId       String?
  targetMoveId String?

  repertoire Repertoire      @relation(fields: [repertoireId], references: [id], onDelete: Cascade)
  node       RepertoireNode? @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  targetMove RepertoireMove? @relation(fields: [targetMoveId], references: [id], onDelete: SetNull)

  // Natural Language Explanation of the plan (e.g. from Gemini)
  explanation String?
  tags        String?

  // --- EXACT TS-FSRS CARD OBJECT ---
  due            DateTime  @default(now()) // Next review date
  stability      Float     @default(0) // Memory stability
  difficulty     Float     @default(0) // Memory difficulty
  elapsed_days   Int       @default(0) // Days since last review
  scheduled_days Int       @default(0) // The new "Interval"
  reps           Int       @default(0) // Total times reviewed
  lapses         Int       @default(0) // Times you pressed "1" (Again)
  state          Int       @default(0) // 0=New, 1=Learning, 2=Review, 3=Relearning
  last_review    DateTime? // When you last saw it

  createdAt DateTime @default(now())

  @@unique([repertoireId, positionKey, targetUci])
  @@unique([repertoireId, nodeId])
}
