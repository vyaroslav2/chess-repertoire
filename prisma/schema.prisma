// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Since Docker wasn't running locally, we are using SQLite for the local environment.
// This is perfect for local testing and can be effortlessly swapped to "postgresql" 
// in the future if you decide to host the application.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(uuid())
  username     String       @unique
  repertoires  Repertoire[]
}

model Repertoire {
  id           String                   @id @default(uuid())
  title        String
  color        String                   // "white" or "black"
  userId       String
  user         User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stats        RepertoirePositionStat[]
}

model Position {
  id             String   @id @default(uuid())
  fen            String   @unique
  
  eco            String?
  openingName    String?
  wikiText       String?
  isTrap         Boolean  @default(false)

  incomingMoves  Move[]   @relation("IncomingMoves")
  outgoingMoves  Move[]   @relation("OutgoingMoves")
  repertoireStats RepertoirePositionStat[]
  engineEvals    EngineEval[]
  explorerMoves  ExplorerMove[]
}

model Move {
  id             String   @id @default(uuid())
  san            String
  fromPositionId String
  toPositionId   String

  eval           Float?
  prob           Float?
  cumulativeProb Float?
  
  mastersGames   Int?
  mastersWin     Float?
  mastersDraw    Float?
  mastersLoss    Float?

  lichessGames   Int?
  lichessWin     Float?
  lichessDraw    Float?
  lichessLoss    Float?

  weightedCount  Int?

  fromPosition   Position @relation("OutgoingMoves", fields: [fromPositionId], references: [id], onDelete: Cascade)
  toPosition     Position @relation("IncomingMoves", fields: [toPositionId], references: [id], onDelete: Cascade)
  stats          RepertoirePositionStat[]
}

model EngineEval {
  id         String   @id @default(uuid())
  positionId String
  san        String
  cp         Float
  mate       Int?
  rank       Int
  
  position   Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
}

model ExplorerMove {
  id         String   @id @default(uuid())
  positionId String
  dbType     String
  san        String
  games      Int
  win        Float
  draw       Float
  loss       Float
  rank       Int
  
  position   Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
}

model RepertoirePositionStat {
  id           String     @id @default(uuid())
  repertoireId String
  positionId   String
  targetMoveId String

  repertoire   Repertoire @relation(fields: [repertoireId], references: [id], onDelete: Cascade)
  position     Position   @relation(fields: [positionId], references: [id], onDelete: Cascade)
  targetMove   Move       @relation(fields: [targetMoveId], references: [id], onDelete: Cascade)

  // Natural Language Explanation of the plan (e.g. from Gemini)
  explanation  String?
  tags         String?

  // --- EXACT TS-FSRS CARD OBJECT ---
  due            DateTime @default(now()) // Next review date
  stability      Float    @default(0)     // Memory stability
  difficulty     Float    @default(0)     // Memory difficulty
  elapsed_days   Int      @default(0)     // Days since last review
  scheduled_days Int      @default(0)     // The new "Interval"
  reps           Int      @default(0)     // Total times reviewed
  lapses         Int      @default(0)     // Times you pressed "1" (Again)
  state          Int      @default(0)     // 0=New, 1=Learning, 2=Review, 3=Relearning
  last_review    DateTime?                // When you last saw it
  
  createdAt      DateTime @default(now())

  @@unique([repertoireId, positionId]) // Ensure a user has only one set of stats per position per repertoire
}
