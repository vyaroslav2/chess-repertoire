   "isDeleted": false,
   "boundElements": [],
   "updated": 1786830000000,
   "locked": false,
   "text": "One attempt only. No retries, no\nwaiting, no rate-limit handling -\nunlike the Lichess requests, which go\nthrough FR.",
   "rawText": "One attempt only. No retries, no\nwaiting, no rate-limit handling -\nunlike the Lichess requests, which go\nthrough FR.",
   "fontSize": 20,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "OBnMq9lRw92RkUPOcrFvl",
   "originalText": "One attempt only. No retries, no\nwaiting, no rate-limit handling -\nunlike the Lichess requests, which go\nthrough FR.",
   "autoResize": true,
   "lineHeight": 1.25,
   "hasTextLink": false,
   "link": null
  },
  {
   "id": "Tv88DjqYB6cmK3q4bBH8b",
