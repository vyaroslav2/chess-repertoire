   "index": "a007",
   "roundness": null,
   "seed": 2048652188,
   "version": 1,
   "versionNonce": 785518875,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1786830000000,
   "locked": false,
   "text": "Only the first page in the reply is\nlooked at, and only its identifier is\nchecked. If a real page comes back\nwith no extract at all, reading it\nthrows and the silent catch turns it\ninto \"return nothing\".",
   "rawText": "Only the first page in the reply is\nlooked at, and only its identifier is\nchecked. If a real page comes back\nwith no extract at all, reading it\nthrows and the silent catch turns it\ninto \"return nothing\".",
   "fontSize": 20,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "Tv88DjqYB6cmK3q4bBH8b",
   "originalText": "Only the first page in the reply is\nlooked at, and only its identifier is\nchecked. If a real page comes back\nwith no extract at all, reading it\nthrows and the silent catch turns it\ninto \"return nothing\".",
   "autoResize": true,
   "lineHeight": 1.25,
   "hasTextLink": false,
   "link": null
  },
