  {
   "id": "AES3c3ECtJL2XKYYfoAkV",
   "type": "text",
   "x": 895,
   "y": 1850.0,
   "width": 407.0,
   "height": 150.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
