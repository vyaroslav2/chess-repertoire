  {
   "id": "cgfdWKalHIKJCcla3MUSw",
   "type": "text",
   "x": -985,
   "y": 240.0,
   "width": 407.0,
   "height": 225.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a003",
   "roundness": null,
   "seed": 340214171,
   "version": 1,
   "versionNonce": 197131646,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1786830000000,
   "locked": false,
   "text": "Each move is added as its own step in\nthe address, separated by a slash.\n\nWhether a move is White's or Black's\nis decided by its place in the list:\nfirst, third, fifth and so on are\ntreated as White's. A history that\nbegan with a Black move would be\nnumbered wrongly throughout.",
   "rawText": "Each move is added as its own step in\nthe address, separated by a slash.\n\nWhether a move is White's or Black's\nis decided by its place in the list:\nfirst, third, fifth and so on are\ntreated as White's. A history that\nbegan with a Black move would be\nnumbered wrongly throughout.",
   "fontSize": 20,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "NOmPN5GztwH4xc83Z0Feb",
   "originalText": "Each move is added as its own step in\nthe address, separated by a slash.\n\nWhether a move is White's or Black's\nis decided by its place in the list:\nfirst, third, fifth and so on are\ntreated as White's. A history that\nbegan with a Black move would be\nnumbered wrongly throughout.",
   "autoResize": true,
   "lineHeight": 1.25,
   "hasTextLink": false,
   "link": null
  },
