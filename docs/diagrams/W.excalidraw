   "boundElements": [],
   "updated": 1786830000000,
   "locked": false,
   "text": "Called from two places, both in PC:\nPC.05 when creating a row, and PC.10\nwhen adding a name to a row that had\nnone. Nothing else asks Wikibooks for\nanything.",
   "rawText": "Called from two places, both in PC:\nPC.05 when creating a row, and PC.10\nwhen adding a name to a row that had\nnone. Nothing else asks Wikibooks for\nanything.",
   "fontSize": 20,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "TJVLouRZMHe2vVyBaViX4",
   "originalText": "Called from two places, both in PC:\nPC.05 when creating a row, and PC.10\nwhen adding a name to a row that had\nnone. Nothing else asks Wikibooks for\nanything.",
   "autoResize": true,
   "lineHeight": 1.25,
   "hasTextLink": false,
   "link": null
  },
  {
   "id": "NOmPN5GztwH4xc83Z0Feb",
