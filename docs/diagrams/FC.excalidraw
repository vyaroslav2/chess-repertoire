   "updated": 1786830000000,
   "locked": false,
   "text": "Called from six places in F, once\nper move or per placeholder:\n\nF.12 and F.14 for Masters\nF.19 and F.20 for Elite\nF.26 and F.27 for Amateur\n\nNothing else in the app writes to\nthis cache.",
   "rawText": "Called from six places in F, once\nper move or per placeholder:\n\nF.12 and F.14 for Masters\nF.19 and F.20 for Elite\nF.26 and F.27 for Amateur\n\nNothing else in the app writes to\nthis cache.",
   "fontSize": 20,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "jpDDPuKOGdIicQRzvlu0e",
   "originalText": "Called from six places in F, once\nper move or per placeholder:\n\nF.12 and F.14 for Masters\nF.19 and F.20 for Elite\nF.26 and F.27 for Amateur\n\nNothing else in the app writes to\nthis cache.",
   "autoResize": true,
   "lineHeight": 1.25,
   "hasTextLink": false,
   "link": null
  },
