   "updated": 1786830000000,
   "locked": false,
   "text": "The shortening is done inside\nthis step, by FN. Its only caller\n(F) has already shortened the FEN\nbefore handing it over, so it is\nshortened twice. The second pass\nchanges nothing.",
   "rawText": "The shortening is done inside\nthis step, by FN. Its only caller\n(F) has already shortened the FEN\nbefore handing it over, so it is\nshortened twice. The second pass\nchanges nothing.",
   "fontSize": 20,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "iJ5itnQKmCpgfDRFB2arE",
   "originalText": "The shortening is done inside\nthis step, by FN. Its only caller\n(F) has already shortened the FEN\nbefore handing it over, so it is\nshortened twice. The second pass\nchanges nothing.",
   "autoResize": true,
   "lineHeight": 1.25,
   "hasTextLink": false,
   "link": null
  },
