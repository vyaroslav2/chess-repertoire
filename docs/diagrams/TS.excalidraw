   "updated": 1786856573890,
   "locked": false,
   "text": "Only Black replies are audited, and\nonly ones never audited before.\nWhite's covering moves are never\nchecked against the deep engine.",
   "rawText": "Only Black replies are audited, and\nonly ones never audited before.\nWhite's covering moves are never\nchecked against the deep engine.",
   "fontSize": 20,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "middle",
