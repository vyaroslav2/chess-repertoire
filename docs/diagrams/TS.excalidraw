   "isDeleted": false,
   "boundElements": [],
   "updated": 1786851275633,
   "locked": false,
   "text": "Why 150: about a pawn and a half.\nBelow that, two moves are close\nenough that depth 24 cannot really\nseparate them. Above it, something\nconcrete has been dropped.",
   "rawText": "Why 150: about a pawn and a half.\nBelow that, two moves are close\nenough that depth 24 cannot really\nseparate them. Above it, something\nconcrete has been dropped.",
   "fontSize": 20,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "6W2AdbOFXlUBlYgjl0yVC",
   "originalText": "Why 150: about a pawn and a half.\nBelow that, two moves are close\nenough that depth 24 cannot really\nseparate them. Above it, something\nconcrete has been dropped.",
   "autoResize": true,
   "lineHeight": 1.25,
   "hasTextLink": false,
   "link": null
  },
