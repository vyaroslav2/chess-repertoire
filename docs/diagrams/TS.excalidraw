   "locked": false,
   "text": "The position comes from the node as\nstored, so it is the shortened FEN\nfrom FN, with no half-move clock. The\nengine is given it as it is.",
   "rawText": "The position comes from the node as\nstored, so it is the shortened FEN\nfrom FN, with no half-move clock. The\nengine is given it as it is.",
   "fontSize": 20,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "yFNWvetfGMi4tQmzEzJ9f",
   "originalText": "The position comes from the node as\nstored, so it is the shortened FEN\nfrom FN, with no half-move clock. The\nengine is given it as it is.",
   "autoResize": true,
   "lineHeight": 1.25,
   "hasTextLink": false,
