   "verticalAlign": "middle",
   "containerId": "8D9LpQOfGCKcVVegfN0wn",
   "originalText": "TS.18 · Append a block\nto the report containing:\n\n• the from-node ID\n• its FEN\n• its PGN move history\n• our move and its score\n• the engine's best move\n  and its score\n• the reason and score\n  difference\n\nLeave the move\nunverified.",
   "autoResize": true,
   "lineHeight": 1.25,
   "hasTextLink": false,
   "link": null
  },
