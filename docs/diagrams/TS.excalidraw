   "updated": 1786830000000,
   "locked": false,
   "text": "The sweeper never changes or removes\na move. All it can do is mark a move\ndeep-verified, or write a paragraph\ninto the report and leave the move\nalone. Acting on a flagged move is\nleft to you.",
   "rawText": "The sweeper never changes or removes\na move. All it can do is mark a move\ndeep-verified, or write a paragraph\ninto the report and leave the move\nalone. Acting on a flagged move is\nleft to you.",
   "fontSize": 20,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "j6R3uZbAx7tJrNr65aGOS",
   "originalText": "The sweeper never changes or removes\na move. All it can do is mark a move\ndeep-verified, or write a paragraph\ninto the report and leave the move\nalone. Acting on a flagged move is\nleft to you.",
   "autoResize": true,
   "lineHeight": 1.25,
   "hasTextLink": false,
   "link": null
  },
