   "isDeleted": false,
   "boundElements": [],
   "updated": 1786851275633,
   "locked": false,
   "text": "Everything after TS.04 sits inside\none catch-all. If the engine throws\n- missing stockfish.exe - the whole\nsweep stops there, though the\nlockfile is still cleaned up.",
   "rawText": "Everything after TS.04 sits inside\none catch-all. If the engine throws\n- missing stockfish.exe - the whole\nsweep stops there, though the\nlockfile is still cleaned up.",
   "fontSize": 20,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "fG6S3ljSyJDfT9qzQsMCf",
   "originalText": "Everything after TS.04 sits inside\none catch-all. If the engine throws\n- missing stockfish.exe - the whole\nsweep stops there, though the\nlockfile is still cleaned up.",
   "autoResize": true,
   "lineHeight": 1.25,
   "hasTextLink": false,
   "link": null
  },
