   "version": 2,
   "versionNonce": 1332359122,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1786851275633,
   "locked": false,
   "text": "Two engine runs at depth 24 for\nevery move that is not already the\nengine's first choice. A full sweep\nover a large repertoire takes a\nlong time - this is the slowest\nthing in the project.",
   "rawText": "Two engine runs at depth 24 for\nevery move that is not already the\nengine's first choice. A full sweep\nover a large repertoire takes a\nlong time - this is the slowest\nthing in the project.",
   "fontSize": 20,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "1er6vmQv72TtACbLOa4Nc",
   "originalText": "Two engine runs at depth 24 for\nevery move that is not already the\nengine's first choice. A full sweep\nover a large repertoire takes a\nlong time - this is the slowest\nthing in the project.",
   "autoResize": true,
   "lineHeight": 1.25,
   "hasTextLink": false,
   "link": null
  },
