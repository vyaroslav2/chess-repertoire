   "updated": 1786830000000,
   "locked": false,
   "text": "Checking and creating are two\nseparate steps here, unlike R.03\nwhich tries to create and catches the\nfailure. If a generator run started in\nbetween the two, both would proceed.",
   "rawText": "Checking and creating are two\nseparate steps here, unlike R.03\nwhich tries to create and catches the\nfailure. If a generator run started in\nbetween the two, both would proceed.",
   "fontSize": 20,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "jgWzORy0bgGRCX0RYTuR9",
   "originalText": "Checking and creating are two\nseparate steps here, unlike R.03\nwhich tries to create and catches the\nfailure. If a generator run started in\nbetween the two, both would proceed.",
   "autoResize": true,
   "lineHeight": 1.25,
   "hasTextLink": false,
   "link": null
  },
