   "index": "a098",
   "roundness": null,
   "seed": 1138081460,
   "version": 2,
   "versionNonce": 1308124562,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1786851275633,
   "locked": false,
   "text": "A flagged move stays unverified on\npurpose, so you can review it. But\nnothing records that it was already\nflagged, so the next sweep audits\nit again and appends the same block\nto the report a second time.",
   "rawText": "A flagged move stays unverified on\npurpose, so you can review it. But\nnothing records that it was already\nflagged, so the next sweep audits\nit again and appends the same block\nto the report a second time.",
   "fontSize": 20,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "7uJjexJ9LPZC9k6DyaDzN",
   "originalText": "A flagged move stays unverified on\npurpose, so you can review it. But\nnothing records that it was already\nflagged, so the next sweep audits\nit again and appends the same block\nto the report a second time.",
   "autoResize": true,
   "lineHeight": 1.25,
   "hasTextLink": false,
   "link": null
  },
