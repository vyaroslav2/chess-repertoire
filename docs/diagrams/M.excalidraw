  {
   "id": "hZgQ6JuP",
   "type": "text",
   "x": 845,
   "y": 665,
   "width": 385,
   "height": 150,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a024",
   "roundness": null,
   "seed": 1570799343,
   "version": 2,
   "versionNonce": 43026190,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1786851253716,
   "locked": false,
   "text": "Why smoothing: a move played once\nand won once is not a 100% move.\nAdding 50 imaginary games at\nroughly even pulls thin evidence\nback towards even, and leaves\nwell-played moves almost untouched.",
   "rawText": "Why smoothing: a move played once\nand won once is not a 100% move.\nAdding 50 imaginary games at\nroughly even pulls thin evidence\nback towards even, and leaves\nwell-played moves almost untouched.",
   "fontSize": 20,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "SbtS3yReOtG6kDZbx5ECj",
   "originalText": "Why smoothing: a move played once\nand won once is not a 100% move.\nAdding 50 imaginary games at\nroughly even pulls thin evidence\nback towards even, and leaves\nwell-played moves almost untouched.",
   "autoResize": true,
   "lineHeight": 1.25,
   "hasTextLink": false,
   "link": null
  },
  {
   "id": "JFl8rf1fyfaaTLHKZXiyA",
   "type": "rectangle",
   "x": 840,
   "y": 900,
   "width": 440,
   "height": 240,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "#b2f2bb",
