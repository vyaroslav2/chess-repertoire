  },
  {
   "id": "MM61NA7G",
   "type": "text",
   "x": 845,
   "y": 945,
   "width": 363,
   "height": 150,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a026",
   "roundness": null,
   "seed": 434707997,
   "version": 2,
   "versionNonce": 625505614,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1786851253716,
   "locked": false,
   "text": "Why 30000: it is far beyond any\nreal centipawn score, so a forced\nmate always outranks any ordinary\nmove, and mate in 2 outranks\nmate in 5 because fewer moves\nsubtracts less.",
   "rawText": "Why 30000: it is far beyond any\nreal centipawn score, so a forced\nmate always outranks any ordinary\nmove, and mate in 2 outranks\nmate in 5 because fewer moves\nsubtracts less.",
   "fontSize": 20,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "JFl8rf1fyfaaTLHKZXiyA",
   "originalText": "Why 30000: it is far beyond any\nreal centipawn score, so a forced\nmate always outranks any ordinary\nmove, and mate in 2 outranks\nmate in 5 because fewer moves\nsubtracts less.",
   "autoResize": true,
   "lineHeight": 1.25,
   "hasTextLink": false,
   "link": null
  },
