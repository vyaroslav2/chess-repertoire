   "versionNonce": 1188385422,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1786851253715,
   "locked": false,
   "text": "Black's version of the win rate is\nnot this function. B1.6 writes the\nsame formula out by hand with 48%\ninstead of 52%. Two copies of one\nidea, in two places.",
   "rawText": "Black's version of the win rate is\nnot this function. B1.6 writes the\nsame formula out by hand with 48%\ninstead of 52%. Two copies of one\nidea, in two places.",
   "fontSize": 20,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "pJcS79Pw6ek40vin0K1jZ",
   "originalText": "Black's version of the win rate is\nnot this function. B1.6 writes the\nsame formula out by hand with 48%\ninstead of 52%. Two copies of one\nidea, in two places.",
   "autoResize": true,
   "lineHeight": 1.25,
   "hasTextLink": false,
   "link": null
  },
  {
   "id": "yUjHqXRgDZpy4RffY8CcS",
   "type": "rectangle",
   "x": 840,
   "y": 320,
   "width": 440,
   "height": 260,
   "angle": 0,
   "strokeColor": "#1e1e1e",
