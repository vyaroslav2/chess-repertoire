  },
  {
   "id": "xn4f6qbp",
   "type": "text",
   "x": 845,
   "y": 375,
   "width": 385,
   "height": 150,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a022",
   "roundness": null,
   "seed": 713001921,
   "version": 3,
   "versionNonce": 770166990,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1786851253716,
   "locked": false,
   "text": "The maths file holds a second\ntolerance table (80 / 50 / 35, no\nlocal column). Nothing imports it.\nThe one that actually runs is the\nengine file's. Dead code that reads\nas if it were live.",
   "rawText": "The maths file holds a second\ntolerance table (80 / 50 / 35, no\nlocal column). Nothing imports it.\nThe one that actually runs is the\nengine file's. Dead code that reads\nas if it were live.",
   "fontSize": 20,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "yUjHqXRgDZpy4RffY8CcS",
   "originalText": "The maths file holds a second\ntolerance table (80 / 50 / 35, no\nlocal column). Nothing imports it.\nThe one that actually runs is the\nengine file's. Dead code that reads\nas if it were live.",
   "autoResize": true,
   "lineHeight": 1.25,
   "hasTextLink": false,
   "link": null
  },
  {
   "id": "SbtS3yReOtG6kDZbx5ECj",
   "type": "rectangle",
   "x": 840,
