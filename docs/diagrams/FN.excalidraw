   "hasTextLink": false
  },
  {
   "id": "iA1rT7ub",
   "type": "text",
   "x": 345,
   "y": 375,
   "width": 374,
   "height": 150,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a017",
   "roundness": null,
   "seed": 1811446596,
   "version": 4,
   "versionNonce": 997008530,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1786850889415,
   "locked": false,
   "text": "Why: the same position reached\nby different move orders, or after\na different number of moves, gets\nthe same key. Without this, every\ncache lookup would miss and the\napp would re-fetch everything.",
   "rawText": "Why: the same position reached\nby different move orders, or after\na different number of moves, gets\nthe same key. Without this, every\ncache lookup would miss and the\napp would re-fetch everything.",
   "fontSize": 20,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "EFmbdHc7JAZoAkwicAD1Y",
   "originalText": "Why: the same position reached\nby different move orders, or after\na different number of moves, gets\nthe same key. Without this, every\ncache lookup would miss and the\napp would re-fetch everything.",
   "autoResize": true,
   "lineHeight": 1.25,
   "hasTextLink": false,
   "link": null
  },
  {
   "id": "H4n7ilKYqy7a1nlOP87Rv",
   "type": "rectangle",
   "x": 340,
   "y": 600,
   "width": 448.0,
   "height": 315.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "#b2f2bb",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a018",
   "roundness": null,
   "seed": 1985372108,
   "version": 1,
   "versionNonce": 169502033,
   "isDeleted": false,
   "boundElements": [
    {
     "type": "text",
     "id": "3OZFUSwF"
    }
   ],
   "updated": 1786830000000,
   "link": null,
   "locked": false,
   "hasTextLink": false
  },
  {
   "id": "3OZFUSwF",
   "type": "text",
   "x": 355,
   "y": 620.0,
   "width": 418.0,
   "height": 275.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a019",
   "roundness": null,
   "seed": 532404295,
   "version": 4,
   "versionNonce": 1329513042,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1786850889415,
   "locked": false,
   "text": "Node FENs are stored shortened, so\nanything reading one back gets a FEN\nwith only four parts. chess.js accepts\nthat and fills the two missing numbers\nin as 0 and 1, so reading is safe.\n\nComparing is not. The generator looks\nfor an existing node by full FEN\nagainst these shortened ones, so that\ncheck never matches - see the note on\nDB.06.",
   "rawText": "Node FENs are stored shortened, so\nanything reading one back gets a FEN\nwith only four parts. chess.js accepts\nthat and fills the two missing numbers\nin as 0 and 1, so reading is safe.\n\nComparing is not. The generator looks\nfor an existing node by full FEN\nagainst these shortened ones, so that\ncheck never matches - see the note on\nDB.06.",
   "fontSize": 20,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "H4n7ilKYqy7a1nlOP87Rv",
   "originalText": "Node FENs are stored shortened, so\nanything reading one back gets a FEN\nwith only four parts. chess.js accepts\nthat and fills the two missing numbers\nin as 0 and 1, so reading is safe.\n\nComparing is not. The generator looks\nfor an existing node by full FEN\nagainst these shortened ones, so that\ncheck never matches - see the note on\nDB.06.",
   "autoResize": true,
   "lineHeight": 1.25,
   "hasTextLink": false,
   "link": null
  },
  {
   "id": "rjIwxWaffHTEhA2l1HrPy",
   "type": "rectangle",
   "x": 340,
   "y": 860,
   "width": 420,
   "height": 240,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "#ffec99",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a02",
   "roundness": null,
   "seed": 1337436368,
   "version": 2,
   "versionNonce": 762419538,
   "isDeleted": false,
   "boundElements": [
    {
     "type": "text",
     "id": "yLzi5Xfl"
    }
   ],
   "updated": 1786850865606,
   "link": null,
   "locked": false,
   "hasTextLink": false
  },
  {
   "id": "yLzi5Xfl",
   "type": "text",
   "x": 345,
   "y": 905,
   "width": 374,
   "height": 150,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a021",
   "roundness": null,
   "seed": 908911043,
   "version": 4,
   "versionNonce": 982951954,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1786850889415,
   "locked": false,
   "text": "The local engine is also given the\nshortened FEN, so it has no\nhalf-move clock. It cannot know\nhow close the position is to the\nfifty-move draw rule. Harmless in\nthe opening, wrong later on.",
   "rawText": "The local engine is also given the\nshortened FEN, so it has no\nhalf-move clock. It cannot know\nhow close the position is to the\nfifty-move draw rule. Harmless in\nthe opening, wrong later on.",
   "fontSize": 20,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "rjIwxWaffHTEhA2l1HrPy",
   "originalText": "The local engine is also given the\nshortened FEN, so it has no\nhalf-move clock. It cannot know\nhow close the position is to the\nfifty-move draw rule. Harmless in\nthe opening, wrong later on.",
   "autoResize": true,
   "lineHeight": 1.25,
   "hasTextLink": false,
   "link": null
  },
  {
   "id": "rN9tP33MJqgs69j9neGhq",
   "type": "rectangle",
   "x": 340,
   "y": 1140,
   "width": 420,
   "height": 190,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "#ffec99",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
