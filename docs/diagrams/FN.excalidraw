   "locked": false,
   "hasTextLink": false
  },
  {
   "id": "QyTwPVYX",
   "type": "text",
   "x": 345,
   "y": 1185,
   "width": 374,
   "height": 100,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a023",
   "roundness": null,
   "seed": 607194157,
   "version": 4,
   "versionNonce": 1164694994,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1786850889415,
   "locked": false,
   "text": "No check that the FEN had four\nparts to begin with. A malformed\nFEN produces a short key and is\nstored under it without complaint.",
   "rawText": "No check that the FEN had four\nparts to begin with. A malformed\nFEN produces a short key and is\nstored under it without complaint.",
   "fontSize": 20,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "rN9tP33MJqgs69j9neGhq",
   "originalText": "No check that the FEN had four\nparts to begin with. A malformed\nFEN produces a short key and is\nstored under it without complaint.",
   "autoResize": true,
   "lineHeight": 1.25,
   "hasTextLink": false,
   "link": null
  },
