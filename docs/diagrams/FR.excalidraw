   "isDeleted": false,
   "boundElements": [],
   "updated": 1786830000000,
   "locked": false,
   "text": "The token is used unless the caller\nswitches it off. Only the engine-\nevaluation request (B2.08) does, so\nthe three explorer requests in F send\nit whenever the environment variable\nis set.",
   "rawText": "The token is used unless the caller\nswitches it off. Only the engine-\nevaluation request (B2.08) does, so\nthe three explorer requests in F send\nit whenever the environment variable\nis set.",
   "fontSize": 20,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "7CFODfX2qnjgTUG7W4vz0",
   "originalText": "The token is used unless the caller\nswitches it off. Only the engine-\nevaluation request (B2.08) does, so\nthe three explorer requests in F send\nit whenever the environment variable\nis set.",
   "autoResize": true,
   "lineHeight": 1.25,
   "hasTextLink": false,
   "link": null
  },
  {
   "id": "jx2dyvxjFpoHwAaVNWPl1",
