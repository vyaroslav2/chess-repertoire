   "index": "a005",
   "roundness": null,
   "seed": 533126537,
   "version": 1,
   "versionNonce": 729437504,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1786830000000,
   "locked": false,
   "text": "Choosing s ends the process on the\nspot. The clean-up step in R.14 never\nruns, so generator.lock is left behind\nand the next run refuses to start\nuntil it is deleted by hand.",
   "rawText": "Choosing s ends the process on the\nspot. The clean-up step in R.14 never\nruns, so generator.lock is left behind\nand the next run refuses to start\nuntil it is deleted by hand.",
   "fontSize": 20,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "rZf62RgtFYRKr3QWPugmv",
   "originalText": "Choosing s ends the process on the\nspot. The clean-up step in R.14 never\nruns, so generator.lock is left behind\nand the next run refuses to start\nuntil it is deleted by hand.",
   "autoResize": true,
   "lineHeight": 1.25,
   "hasTextLink": false,
   "link": null
  },
