  {
   "id": "EQtoMYt3ZAsV3mZHXm3Lx",
   "type": "text",
   "x": 1165,
   "y": 1580.0,
   "width": 418.0,
   "height": 125.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
