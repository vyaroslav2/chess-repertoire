   "isDeleted": false,
   "boundElements": [],
   "updated": 1786830000000,
   "locked": false,
   "text": "This switch is already off when the\nrun starts and nothing anywhere turns\nit on, so turning it off changes\nnothing today. See the note on B2.06.",
   "rawText": "This switch is already off when the\nrun starts and nothing anywhere turns\nit on, so turning it off changes\nnothing today. See the note on B2.06.",
   "fontSize": 20,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "5Lcx0gI7iTZ1AcieohlIP",
   "originalText": "This switch is already off when the\nrun starts and nothing anywhere turns\nit on, so turning it off changes\nnothing today. See the note on B2.06.",
   "autoResize": true,
