  {
   "id": "RdSOWN1IjKSlrY7G9J5zw",
   "type": "text",
   "x": -1165,
   "y": 1620.0,
   "width": 418.0,
   "height": 150.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a003",
   "roundness": null,
   "seed": 937332828,
   "version": 1,
   "versionNonce": 135597065,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1786830000000,
   "locked": false,
   "text": "A manual retry is a fresh start, not a\ncontinuation: the count of 10 begins\nagain at zero every time, and each\nretry sits inside the one before it.\nThere is no overall limit on how long\nthis can go on.",
   "rawText": "A manual retry is a fresh start, not a\ncontinuation: the count of 10 begins\nagain at zero every time, and each\nretry sits inside the one before it.\nThere is no overall limit on how long\nthis can go on.",
   "fontSize": 20,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "jx2dyvxjFpoHwAaVNWPl1",
   "originalText": "A manual retry is a fresh start, not a\ncontinuation: the count of 10 begins\nagain at zero every time, and each\nretry sits inside the one before it.\nThere is no overall limit on how long\nthis can go on.",
   "autoResize": true,
   "lineHeight": 1.25,
   "hasTextLink": false,
   "link": null
  },
  {
   "id": "rZf62RgtFYRKr3QWPugmv",
