   "seed": 69106259,
   "version": 1,
   "versionNonce": 739252814,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1786830000000,
   "locked": false,
   "text": "Deleting one row from\nPositionCache deletes every\nRepertoireNode built on that\nposition, and with them their\nmoves and study stats. The cache\nis the parent of the repertoire,\nnot the other way round.",
   "rawText": "Deleting one row from\nPositionCache deletes every\nRepertoireNode built on that\nposition, and with them their\nmoves and study stats. The cache\nis the parent of the repertoire,\nnot the other way round.",
   "fontSize": 20,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "8e38OXntBg6gblkBBJqqk",
   "originalText": "Deleting one row from\nPositionCache deletes every\nRepertoireNode built on that\nposition, and with them their\nmoves and study stats. The cache\nis the parent of the repertoire,\nnot the other way round.",
   "autoResize": true,
   "lineHeight": 1.25,
   "hasTextLink": false,
   "link": null
  },
  {
   "id": "B5HUHsZfmZrUo1wv33Hcp",
   "type": "rectangle",
   "x": 1230,
   "y": 240,
   "width": 470,
   "height": 340.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
