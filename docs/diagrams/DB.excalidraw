   "index": "a011",
   "roundness": null,
   "seed": 618264738,
   "version": 1,
   "versionNonce": 246753864,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1786830000000,
   "locked": false,
   "text": "One row per repertoire and node:\neach node can have one study card.\nThat card points to one target\nmove.\n\nExplanation is not written by\nGemini: it is a generated one-line\nsummary of score, weighted volume\nand evaluation.\n\nTags is never written or read by\nanything.",
   "rawText": "One row per repertoire and node:\neach node can have one study card.\nThat card points to one target\nmove.\n\nExplanation is not written by\nGemini: it is a generated one-line\nsummary of score, weighted volume\nand evaluation.\n\nTags is never written or read by\nanything.",
   "fontSize": 20,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "QWIcCslfxh96uxHlOXSqY",
   "originalText": "One row per repertoire and node:\neach node can have one study card.\nThat card points to one target\nmove.\n\nExplanation is not written by\nGemini: it is a generated one-line\nsummary of score, weighted volume\nand evaluation.\n\nTags is never written or read by\nanything.",
   "autoResize": true,
   "lineHeight": 1.25,
   "hasTextLink": false,
   "link": null
  },
