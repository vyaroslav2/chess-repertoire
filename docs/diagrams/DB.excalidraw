   "locked": false,
   "hasTextLink": false
  },
  {
   "id": "JGUGExL2EMY0IQDoyK3ww",
   "type": "text",
   "x": 1245,
   "y": 260.0,
   "width": 352.0,
   "height": 300.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a003",
   "roundness": null,
   "seed": 988027888,
   "version": 1,
   "versionNonce": 788351535,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1786830000000,
   "locked": false,
   "text": "One row per position, move and\nsource: lichess, chessdb or\nlocal_deep.\n\nB3 writes local_deep. B2 sees\nlocal_deep when checking whether\nany engine cache exists, but\nrebuilds engine lists only from\nlichess or chessdb. Therefore a\nlocal_deep-only row can block a\nfresh API fetch while its score\nis not used.",
   "rawText": "One row per position, move and\nsource: lichess, chessdb or\nlocal_deep.\n\nB3 writes local_deep. B2 sees\nlocal_deep when checking whether\nany engine cache exists, but\nrebuilds engine lists only from\nlichess or chessdb. Therefore a\nlocal_deep-only row can block a\nfresh API fetch while its score\nis not used.",
   "fontSize": 20,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "B5HUHsZfmZrUo1wv33Hcp",
   "originalText": "One row per position, move and\nsource: lichess, chessdb or\nlocal_deep.\n\nB3 writes local_deep. B2 sees\nlocal_deep when checking whether\nany engine cache exists, but\nrebuilds engine lists only from\nlichess or chessdb. Therefore a\nlocal_deep-only row can block a\nfresh API fetch while its score\nis not used.",
   "autoResize": true,
   "lineHeight": 1.25,
   "hasTextLink": false,
   "link": null
  },
  {
   "id": "eW8PnrYhpdNEbLuSk1eDK",
   "type": "rectangle",
   "x": 1050,
   "y": 880,
   "width": 470,
   "height": 290.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
