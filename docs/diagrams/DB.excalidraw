  {
   "id": "VpAMfCYy43L032ScPuvaa",
   "type": "text",
   "x": -1635,
   "y": 1670.0,
   "width": 374.0,
   "height": 300.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
