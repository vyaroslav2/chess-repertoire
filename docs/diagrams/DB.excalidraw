  },
  {
   "id": "UTlL2lNGFl3xPHrN8Sz9s",
   "type": "text",
   "x": -855,
   "y": 1470.0,
   "width": 341.0,
   "height": 200.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a009",
   "roundness": null,
   "seed": 1325122256,
   "version": 1,
   "versionNonce": 1492806585,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1786830000000,
   "locked": false,
   "text": "One move per from-node and SAN.\n\nThe Lichess and ChessDB scores\nare divided by 100 before being\nstored here, so they are in\npawns - while the same numbers\nin EngineEvalCache are kept in\ncentipawns.",
   "rawText": "One move per from-node and SAN.\n\nThe Lichess and ChessDB scores\nare divided by 100 before being\nstored here, so they are in\npawns - while the same numbers\nin EngineEvalCache are kept in\ncentipawns.",
   "fontSize": 20,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "DNBhi736kApTfmO92vTTT",
   "originalText": "One move per from-node and SAN.\n\nThe Lichess and ChessDB scores\nare divided by 100 before being\nstored here, so they are in\npawns - while the same numbers\nin EngineEvalCache are kept in\ncentipawns.",
   "autoResize": true,
   "lineHeight": 1.25,
   "hasTextLink": false,
   "link": null
  },
  {
   "id": "QWIcCslfxh96uxHlOXSqY",
