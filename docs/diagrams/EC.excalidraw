   "version": 1,
   "versionNonce": 1503459059,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1786830000000,
   "locked": false,
   "text": "No error handling here. A failed\nwrite is passed up to the caller:\ninside B2 it is swallowed, in B3\nit would stop the whole run.",
   "rawText": "No error handling here. A failed\nwrite is passed up to the caller:\ninside B2 it is swallowed, in B3\nit would stop the whole run.",
   "fontSize": 20,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "12g5Q6OTYvewAXmnhdd4c",
   "originalText": "No error handling here. A failed\nwrite is passed up to the caller:\ninside B2 it is swallowed, in B3\nit would stop the whole run.",
   "autoResize": true,
   "lineHeight": 1.25,
   "hasTextLink": false,
   "link": null
  },
