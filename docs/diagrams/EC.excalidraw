   "isDeleted": false,
   "boundElements": [],
   "updated": 1786830000000,
   "locked": false,
   "text": "Called from three places, once\nper move:\n\nB2.19 saves lichess rows\nB2.22 saves chessdb rows\nB3.15 saves one local_deep row\n\nThe caller decides the rank; this\nstep trusts whatever it is given.",
   "rawText": "Called from three places, once\nper move:\n\nB2.19 saves lichess rows\nB2.22 saves chessdb rows\nB3.15 saves one local_deep row\n\nThe caller decides the rank; this\nstep trusts whatever it is given.",
   "fontSize": 20,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "os0ZPyYQouttltrViyZGo",
   "originalText": "Called from three places, once\nper move:\n\nB2.19 saves lichess rows\nB2.22 saves chessdb rows\nB3.15 saves one local_deep row\n\nThe caller decides the rank; this\nstep trusts whatever it is given.",
   "autoResize": true,
   "lineHeight": 1.25,
   "hasTextLink": false,
   "link": null
  },
  {
