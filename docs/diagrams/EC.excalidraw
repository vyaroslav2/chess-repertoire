  {
   "id": "XqkYFaLM3aP7z67hGTA1z",
   "type": "text",
   "x": 575,
   "y": 900.0,
   "width": 363.0,
   "height": 150.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a007",
   "roundness": null,
   "seed": 1403160330,
   "version": 1,
   "versionNonce": 1786681733,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1786830000000,
   "locked": false,
   "text": "Nothing ever deletes a row and\nnothing expires. A score saved\nmonths ago is trusted for ever,\nand rows left over from an older,\nlonger answer keep their old\nranks alongside the new ones.",
   "rawText": "Nothing ever deletes a row and\nnothing expires. A score saved\nmonths ago is trusted for ever,\nand rows left over from an older,\nlonger answer keep their old\nranks alongside the new ones.",
   "fontSize": 20,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "PlxgfulzxQct5ve2aMvrV",
   "originalText": "Nothing ever deletes a row and\nnothing expires. A score saved\nmonths ago is trusted for ever,\nand rows left over from an older,\nlonger answer keep their old\nranks alongside the new ones.",
   "autoResize": true,
   "lineHeight": 1.25,
   "hasTextLink": false,
   "link": null
  },
