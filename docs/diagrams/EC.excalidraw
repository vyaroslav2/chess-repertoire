   "version": 1,
   "versionNonce": 1581626943,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1786830000000,
   "locked": false,
   "text": "Because the source is part of the\nkey, one move can hold three rows\nat once - one per source. Nothing\never compares them or picks\nbetween them here.",
   "rawText": "Because the source is part of the\nkey, one move can hold three rows\nat once - one per source. Nothing\never compares them or picks\nbetween them here.",
   "fontSize": 20,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "EoMviQeqZKlQCesqMmx0v",
   "originalText": "Because the source is part of the\nkey, one move can hold three rows\nat once - one per source. Nothing\never compares them or picks\nbetween them here.",
   "autoResize": true,
   "lineHeight": 1.25,
   "hasTextLink": false,
   "link": null
  },
