   "version": 1,
   "versionNonce": 1830863083,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1786830000000,
   "locked": false,
   "text": "Both Lichess requests ask for\nclassical and rapid games only,\nso blitz and bullet never count.\n\nElite asks for the 2500 rating\nband, Amateur for the 1600, 1800\nand 2000 bands. Nothing between\n2200 and 2499 is looked at by\neither.",
   "rawText": "Both Lichess requests ask for\nclassical and rapid games only,\nso blitz and bullet never count.\n\nElite asks for the 2500 rating\nband, Amateur for the 1600, 1800\nand 2000 bands. Nothing between\n2200 and 2499 is looked at by\neither.",
   "fontSize": 20,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "faJAq1aORyp8CiAJtHeZl",
   "originalText": "Both Lichess requests ask for\nclassical and rapid games only,\nso blitz and bullet never count.\n\nElite asks for the 2500 rating\nband, Amateur for the 1600, 1800\nand 2000 bands. Nothing between\n2200 and 2499 is looked at by\neither.",
   "autoResize": true,
   "lineHeight": 1.25,
   "hasTextLink": false,
   "link": null
  },
