   "isDeleted": false,
   "boundElements": [],
   "updated": 1786830000000,
   "locked": false,
   "text": "\"Total games\" for a move is worked\nout here as White wins + draws +\nBlack wins. The games number the\nAPI sends back is ignored.",
   "rawText": "\"Total games\" for a move is worked\nout here as White wins + draws +\nBlack wins. The games number the\nAPI sends back is ignored.",
   "fontSize": 20,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "h7vXOD6JxhGtadLR9ZNYN",
   "originalText": "\"Total games\" for a move is worked\nout here as White wins + draws +\nBlack wins. The games number the\nAPI sends back is ignored.",
   "autoResize": true,
   "lineHeight": 1.25,
   "hasTextLink": false,
   "link": null
  },
