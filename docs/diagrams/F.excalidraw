  {
   "id": "HGz5XrQ2UHH0rDd4YCoon",
   "type": "text",
   "x": -985,
   "y": 1140.0,
   "width": 363.0,
   "height": 300.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a005",
   "roundness": null,
   "seed": 2136791925,
   "version": 1,
   "versionNonce": 895649589,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1786830000000,
   "locked": false,
   "text": "Rebuilding from the cache drops\nthe opening name and ECO code.\nCached rows hold only moves and\ncounts, while those two come from\nthe Masters reply at F.10 and are\nused in A1 to label the position.\n\nSo a position can only ever pick\nup its opening name on a fresh\nfetch. On a cache hit it keeps\nwhatever it already had, or\nnothing.",
   "rawText": "Rebuilding from the cache drops\nthe opening name and ECO code.\nCached rows hold only moves and\ncounts, while those two come from\nthe Masters reply at F.10 and are\nused in A1 to label the position.\n\nSo a position can only ever pick\nup its opening name on a fresh\nfetch. On a cache hit it keeps\nwhatever it already had, or\nnothing.",
   "fontSize": 20,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "eDxbnUnAPkZTiX6drdrAN",
   "originalText": "Rebuilding from the cache drops\nthe opening name and ECO code.\nCached rows hold only moves and\ncounts, while those two come from\nthe Masters reply at F.10 and are\nused in A1 to label the position.\n\nSo a position can only ever pick\nup its opening name on a fresh\nfetch. On a cache hit it keeps\nwhatever it already had, or\nnothing.",
   "autoResize": true,
   "lineHeight": 1.25,
   "hasTextLink": false,
   "link": null
  },
