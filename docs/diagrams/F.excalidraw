   "version": 1,
   "versionNonce": 1815068366,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1786830000000,
   "locked": false,
   "text": "One failed database means all\nthree are fetched again next time.\nA failure saves no rows at all for\nthat database, so the all-three\ntest above keeps failing, and the\ntwo that did succeed are asked for\nagain and rewritten with the same\nnumbers.",
   "rawText": "One failed database means all\nthree are fetched again next time.\nA failure saves no rows at all for\nthat database, so the all-three\ntest above keeps failing, and the\ntwo that did succeed are asked for\nagain and rewritten with the same\nnumbers.",
   "fontSize": 20,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "HmZJT9Ak7vORoEtU5nWM5",
   "originalText": "One failed database means all\nthree are fetched again next time.\nA failure saves no rows at all for\nthat database, so the all-three\ntest above keeps failing, and the\ntwo that did succeed are asked for\nagain and rewritten with the same\nnumbers.",
   "autoResize": true,
   "lineHeight": 1.25,
   "hasTextLink": false,
   "link": null
  },
  {
   "id": "eDxbnUnAPkZTiX6drdrAN",
