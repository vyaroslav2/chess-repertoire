   "updated": 1786830000000,
   "locked": false,
   "text": "The two one-second waits are the\nonly spacing between the three\nrequests. There is none after the\nAmateur request, because the\nfunction ends there.",
   "rawText": "The two one-second waits are the\nonly spacing between the three\nrequests. There is none after the\nAmateur request, because the\nfunction ends there.",
   "fontSize": 20,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "middle",
