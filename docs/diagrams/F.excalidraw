   "isDeleted": false,
   "boundElements": [],
   "updated": 1786843584494,
   "locked": false,
   "text": "If a request fails\nor\nreturns nothing,\nthe code\ndoes not save an\n_EMPTY_\nrow for that\ndatabase.\n\nThe default empty\nresult\njust stays in\nmemory and\nthe flow moves on.",
   "rawText": "If a request fails or\nreturns nothing, the code\ndoes not save an _EMPTY_\nrow for that database.\n\nThe default empty result\njust stays in memory and\nthe flow moves on.",
   "fontSize": 20,
   "fontFamily": 8,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "zDQadmQJ",
   "originalText": "If a request fails or\nreturns nothing, the code\ndoes not save an _EMPTY_\nrow for that database.\n\nThe default empty result\njust stays in memory and\nthe flow moves on.",
   "autoResize": true,
   "lineHeight": 1.25,
   "hasTextLink": false,
   "link": null
  },
